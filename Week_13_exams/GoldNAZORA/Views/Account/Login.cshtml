@{
    ViewData["Title"] = "Giriş Yap";
}

<!-- Giriş sayfasının ana alanı -->
<section class="login-page">
    <div class="login-card">
        <p class="login-brand">Gold<span>NAZORA</span></p>
        <h1>Hoş Geldiniz</h1>
        <p class="login-description ">
            Koleksiyonumuzu keşfetmek için giriş yapın.
        </p>

        <!-- Giriş formu: Account Controller içerisindeki Login Action'ına POST isteği gönderir -->
        <form asp-controller="Account" asp-action="Login" method="post">
            <label for="email">E-posta adresi</label>
            <input type="email" id="email" name="email" placeholder="ornek@email.com" required />

            <label for="password">Şifre</label>
            <input type="password" id="password" name="password" placeholder="Şifre giriniz." required />

            <button type="submit" class="login-button">
                Giriş Yap
            </button>
        </form>

        <!-- Controller tarafından gönderilen mesaj varsa ekranda gösterir -->
        @if (ViewBag.Message != null)
        {
            <p class="login-message">@ViewBag.Message</p>
        }

        <a asp-controller="Home" asp-action="Index" class="back-home">
            Ana sayfaya dön <!--Kullanıcıyı ana sayfaya yönlendirir-->
        </a>
    </div>
</section>
