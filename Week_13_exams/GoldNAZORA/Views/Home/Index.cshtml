@{
    ViewData["Title"] = "GoldNAZORA | Zamansız Zarafet";
}

<main>
    <!-- ANA KARŞILAMA ALANI -->
    <section class="hero" id="anasayfa">
        <div class="hero-content">

            <p class="eyebrow">GoldNAZORA KOLEKSİYONU</p>

            <h1>
                Zarafetin<br>
                en parlak hali.
            </h1>

            <p class="hero-description">
                Her anınıza eşlik edecek, stilinizi tamamlayan
                zamansız takılarla kendinizi ifade edin.
            </p>

            <a href="/Home/Collection" class="primary-button">
                Koleksiyonu Keşfet →
            </a>
        </div>

        <div class="hero-decoration">
            <div class="gold-circle"></div>

            <div class="hero-caption">
               <span >GoldNAZORA</span>
                <p>Zarafet detaylarda saklıdır.</p>
            </div>
        </div>
    </section>

    <!-- KATEGORİLER -->
    <section class="categories" id="koleksiyon">
        <div class="section-heading">
            <p class="eyebrow">SENİN TARZIN, SENİN HİKÂYEN</p>
            <h2>Koleksiyonlarımız</h2>
            <p>Tarzınıza uygun parçayı keşfedin.</p>
        </div>

        <div class="category-grid">
            <a href="/Home/Collection?kategori=kolye" class="category-card">
                <span>01</span>
                <h3>Kolyeler</h3>
                <p>Zarif dokunuşlar →</p>
            </a>

            <a href="/Home/Collection?kategori=yuzuk" class="category-card">
                <span>02</span>
                <h3>Yüzükler</h3>
                <p>Işıltılı detaylar →</p>
            </a>

            <a href="/Home/Collection?kategori=kupe" class="category-card">
                <span>03</span>
                <h3>Küpeler</h3>
                <p>Her ana özel →</p>
            </a>

            <a href="/Home/Collection?kategori=bileklik" class="category-card">
                <span>04</span>
                <h3>Bileklikler</h3>
                <p>Zamansız şıklık →</p>
            </a>
        </div>
    </section>

    <!-- ÖNE ÇIKAN ÜRÜNLER -->
    <section class="products" id="urunler">
        <div class="section-heading">
            <p class="eyebrow">ÖZENLE SEÇİLDİ</p>
            <h2>Öne Çıkan Parçalar</h2>
            <p>GoldNAZORA'nın favori tasarımları.</p>
        </div>

        <div class="product-grid">

            <!-- KOLYE -->
            <article class="product-card">
                <a href="/Home/Collection?kategori=kolye" class="product-image image-one"
                   aria-label="Kolye koleksiyonunu keşfet">

                    <img src="https://images.unsplash.com/photo-1708222169717-8251cfdfa608?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                         alt="GoldNAZORA Özel Tasarım Kolye"
                         style="width:100%; height:320px; object-fit:cover; display:block;">

                    <span class="product-label">ÇOK SATAN</span>
                </a>
                <div class="product-info">
                    <div>
                        <h3>Minimal Altın Kolye</h3>
                        <p>Kolye Koleksiyonu</p>
                    </div>

                    <strong>24.999 TL</strong>
                </div>

                <a href="/Home/Collection?kategori=kolye" class="add-to-cart">
                    Ürünü Keşfet
                </a>
            </article>

            <!-- YÜZÜK -->
            <article class="product-card">
               
                <a href="/Home/Collection?kategori=yuzuk" class="product-image image-two"
                   aria-label="Yüzük koleksiyonunu keşfet">

                    <img src="https://images.unsplash.com/photo-1747116404311-55f8d8944e83?q=80&w=803&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                         alt="Zarif Gümüş Yüzük" style="width:100%; height:320px; object-fit:cover; display:block;">

                    <span class="product-label">YENİ KOLEKSİYON</span>
                </a>
            

                <div class="product-info">
                    <div>
                        <h3>Zarif Gümüş Yüzük</h3>
                        <p>Yüzük Koleksiyonu</p>
                    </div>

                    <strong>14.999 TL</strong>
                </div>

                <a href="/Home/Collection?kategori=yuzuk" class="add-to-cart">
                    Ürünü Keşfet
                </a>
            </article>

            <!-- KÜPE -->
            <article class="product-card">
              
                <a href="/Home/Collection?kategori=kupe" class="product-image image-three"
                   aria-label="Küpe koleksiyonunu keşfet">

                    <img src="https://plus.unsplash.com/premium_photo-1675107359599-a2d0d8983c36?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
                         alt="İnci detaylı küpe" style="width:85%; height:320px; object-fit:cover; display:block;">

                    <span class="product-label">ZAMANSIZ TASARIM</span>
                </a>



                <div class="product-info">
                    <div>
                        <h3>İnci Detaylı Küpe</h3>
                        <p>Küpe Koleksiyonu</p>
                    </div>

                    <strong>5.999 TL</strong>
                </div>

                <a href="/Home/Collection?kategori=kupe" class="add-to-cart">
                    Ürünü Keşfet
                </a>
            </article>

        </div>
    </section>

    <!-- HAKKIMIZDA -->
    <section class="about" id="hakkimizda">
        <p class="eyebrow">Gold<span>NAZORA</span></p>


        <h2>
            Güzellik geçici,<br />
            <span>zarafet zamansızdır.</span>
        </h2>

        <p>Her detayında kendinden bir parça bulacağın tasarımlar.</p>

        <a href="/Home/About" class="primary-button">
            Hakkımızda →
        </a>
    </section>
</main>

