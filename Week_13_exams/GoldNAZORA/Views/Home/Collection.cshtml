<section class="collection-page">
        <h1 class="collection-title">
                Gold<span>NAZORA</span> Koleksiyonu
        </h1>

        <nav class="collection-categories">
                <a href="/Home/Collection">Tüm Ürünler</a>
                <a href="/Home/Collection?kategori=kolye">Kolye</a>
                <a href="/Home/Collection?kategori=yuzuk">Yüzük</a>
                <a href="/Home/Collection?kategori=kupe">Küpe</a>
                <a href="/Home/Collection?kategori=bileklik">Bileklik</a>
                
        </nav>

        @if (string.IsNullOrEmpty(kategori) || kategori == "kolye")
        {
                @if (string.IsNullOrEmpty(kategori))
                {
                        <h2>Tüm Ürünler </h2>
                }
                else
                {
                        <h2>Kolye</h2>
                }

                <div class="product-container">
                        @foreach (var urun in kolyeler)
                        {
                               
                                <article class="product-card">
                                        <img class="product-image" src="@urun.Image" alt="@urun.Name" loading="lazy" />

                                        <div class="product-info">
                                                <h3>@urun.Name</h3>
                                                <p>@urun.Price</p>

                                                <button type="button" class="add-to-cart" data-name="@urun.Name"
                                                        data-price="@urun.Price" data-image="@urun.Image">
                                                        Sepete Ekle
                                                </button>
                                        </div>
                                </article>

                        }
                </div>
        }
        @if (string.IsNullOrEmpty(kategori) || kategori == "yuzuk")
        {
                <h2>Yüzük</h2>
                <div class="product-container">
                        @foreach (var urun in yuzukler)
                        {
                                
                                <article class="product-card">
                                        <img class="product-image" src="@urun.Image" alt="@urun.Name" loading="lazy" />

                                        <div class="product-info">
                                                <h3>@urun.Name</h3>
                                                <p>@urun.Price</p>

                                                <button type="button" class="add-to-cart" data-name="@urun.Name"
                                                        data-price="@urun.Price" data-image="@urun.Image">
                                                        Sepete Ekle
                                                </button>
                                        </div>
                                </article>

                        }
                </div>
        }

        @if (string.IsNullOrEmpty(kategori) || kategori == "kupe")
        {
                <h2>Küpe</h2>
                <div class="product-container">
                        @foreach (var urun in kupeler)
                        {
                               
                                <article class="product-card">
                                        <img class="product-image" src="@urun.Image" alt="@urun.Name" loading="lazy" />

                                        <div class="product-info">
                                                <h3>@urun.Name</h3>
                                                <p>@urun.Price</p>

                                                <button type="button" class="add-to-cart" data-name="@urun.Name"
                                                        data-price="@urun.Price" data-image="@urun.Image">
                                                        Sepete Ekle
                                                </button>
                                        </div>
                                </article>

                        }
                </div>
        }

        @if (string.IsNullOrEmpty(kategori) || kategori == "bileklik")
        {
                <h2>Bileklik</h2>
                <div class="product-container">
                        @foreach (var urun in bileklikler)
                        {
                              
                                <article class="product-card">
                                        <img class="product-image" src="@urun.Image" alt="@urun.Name" loading="lazy" />

                                        <div class="product-info">
                                                <h3>@urun.Name</h3>
                                                <p>@urun.Price</p>

                                                <button type="button" class="add-to-cart" data-name="@urun.Name"
                                                        data-price="@urun.Price" data-image="@urun.Image">
                                                        Sepete Ekle
                                                </button>
                                        </div>
                                </article>

                        }
                </div>
        }
</section>